# Copy to .env and fill in; load with `set -a; . ./.env; set +a` (never commit .env).

# Claude summaries (optional; extractive fallback without it)
ANTHROPIC_API_KEY=

# Unsubscribe token signing key: any long random string
NEWSBRIEF_SECRET=

# Transport: smtp | resend | sendgrid (auto-detected from the variables below if unset)
NEWSBRIEF_TRANSPORT=

# SMTP (STARTTLS on 587, implicit TLS on 465)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# HTTP email APIs
RESEND_API_KEY=
SENDGRID_API_KEY=
